# DAO Forum Configuration
# Copy this file to .env.local and update with your values
# Environment variables allow you to override DAO forum URLs without modifying code

ANTHROPIC_API_KEY=''
ANTHROPIC_MODEL=''

# SSV Network Forum URL
NEXT_PUBLIC_SSV_NETWORK_URL=https://forum.ssv.network

# Token Engineering Commons Forum URL
NEXT_PUBLIC_TEC_URL=https://forum.tecommons.org

# Default number of days to look back for posts (optional, defaults to 7)
NEXT_PUBLIC_DEFAULT_DAYS=7

